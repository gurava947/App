{
  "name": "inchat-react-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3001 --strictPort",
    "dev:secondary": "vite --host 0.0.0.0 --port 3002 --strictPort",
    "dev:server": "node server.mjs",
    "dev:all": "concurrently -k -n api,web1,web2 \"npm:dev:server\" \"npm:dev\" \"npm:dev:secondary\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "^10.0.7",
    "typescript": "5.7.2",
    "vite": "8.3.8"
  }
}
